# Create a new API key in your API provider dashboard. Never reuse a key that has been shared in chat, email, or screenshots.
OPENAI_API_KEY=replace_with_your_new_key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-luna
ENABLE_WEB_SEARCH=true
PORT=8787
# Set true for QA/Mock mode with no external API usage. Set false for a live LLM demonstration.
MOCK_MODE=false
# Optional for an OpenAI-compatible endpoint:
# OPENAI_API_BASE=https://api.openai.com/v1

# Recommended after configuration: npm run check:live
# Do not include the real .env in a shared package or commit it to source control.
